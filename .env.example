# Set these as encrypted secrets in the Cloudflare Pages dashboard
# (Settings -> Environment variables), or in .dev.vars for local development.

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional: defaults to USD if unset. Set to USD, GHS, NGN, etc. to match your store currency.
PAYSTACK_CURRENCY=USD
# Optional: exchange rate when PAYSTACK_CURRENCY=GHS (converts USD store total to GHS pesewas)
USD_TO_GHS_RATE=11.14

RESEND_API_KEY=
ORDERS_FROM_EMAIL=orders@yourdomain.com
FULFILLMENT_EMAIL=you@yourdomain.com

